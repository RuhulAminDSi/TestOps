# AIQA Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Configuration
SPRING_APPLICATION_NAME=ai-qa-backend
SERVER_PORT=8081

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aiqa
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_OPEN_IN_VIEW=false

# AI Provider Configuration
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1

# Anthropic Claude
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_API_URL=https://api.anthropic.com/v1

# Ollama (Local)
OLLAMA_API_URL=http://localhost:11434/api
OLLAMA_MODEL=llama2

# Opencode AI
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_API_URL=https://api.opencode.ai/v1

# Playwright Configuration
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_SANDBOX_TIMEOUT=60000

# Security Configuration
SECURITY_SCAN_ENABLED=true
SECURITY_MAX_REQUESTS_PER_MINUTE=60

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_AIQA=DEBUG

# Development Configuration
SPRING_DEVTOOLS_RESTART_ENABLED=true
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# File Upload Configuration
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# Feature Flags
FEATURE_AI_SQL_ENABLED=true
FEATURE_SECURITY_SCAN_ENABLED=true
FEATURE_API_AUTOMATION_ENABLED=true
FEATURE_UI_AUTOMATION_ENABLED=true
